# --- Database & Cache ---
POSTGRES_DB=resqai
POSTGRES_USER=resqai_user
POSTGRES_PASSWORD=resqai_pass
DATABASE_URL=postgresql+asyncpg://resqai_user:resqai_pass@localhost:5432/resqai
REDIS_URL=redis://localhost:6379

# --- Security & Authentication ---
SECRET_KEY=resqai_super_secret_jwt_key_2026_dev_environment
JWT_SECRET=resqai_super_secret_jwt_key_2026_dev_environment
ADMIN_PASSWORD=your_admin_password_here

# --- Google Gemini AI ---
AI_API_KEY=dummy_key
AI_MODEL=gemini-3.5-flash-lite

# --- Email OTP Dispatch (Gmail or SMTP) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_specific_password
SMTP_FROM_EMAIL=your_email@gmail.com

# --- Sri Lanka SMS Gateway (SMSlenz) ---
SMSLENZ_USER_ID=2462
SMSLENZ_API_KEY=3ef7d7d9-1ae3-4615-b43c-b795f67375e7
SMSLENZ_SENDER_ID=SMSlenzDEMO
SMSLENZ_BASE_URL=https://smslenz.lk/api

