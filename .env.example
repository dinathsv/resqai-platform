# --- Database & Cache ---
POSTGRES_DB=resqai
POSTGRES_USER=resqai_user
POSTGRES_PASSWORD=replace_with_a_local_database_password
DATABASE_URL=postgresql+asyncpg://resqai_user:replace_with_postgres_password@localhost:5433/resqai
REDIS_URL=redis://localhost:6379

# --- Security & Authentication ---
SECRET_KEY=replace_with_a_random_secret
JWT_SECRET=replace_with_a_different_random_secret
ADMIN_PASSWORD=replace_with_an_admin_password

# --- Google Gemini AI ---
AI_API_KEY=your_gemini_api_key
AI_MODEL=gemini-3.5-flash-lite

# --- Email OTP Dispatch (Gmail or SMTP) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_specific_password
SMTP_FROM_EMAIL=your_email@gmail.com

# --- Sri Lanka SMS Gateway (SMSlenz) ---
SMSLENZ_USER_ID=your_smslenz_user_id
SMSLENZ_API_KEY=your_smslenz_api_key
SMSLENZ_SENDER_ID=your_smslenz_sender_id
SMSLENZ_BASE_URL=https://smslenz.lk/api

# --- Google Maps Configuration ---
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
