# --- Database & Cache ---
POSTGRES_DB=resqai
POSTGRES_USER=resqai_user
POSTGRES_PASSWORD=replace_with_postgres_password
DATABASE_URL=postgresql+asyncpg://resqai_user:replace_with_postgres_password@localhost:5433/resqai
# Docker containers use the service hostname and internal PostgreSQL port.
# Use the same password above (URL-encoded inside connection URLs).
PYTHON_DATABASE_URL=postgresql+asyncpg://resqai_user:replace_with_postgres_password@postgres:5432/resqai
NODE_DATABASE_URL=postgresql://resqai_user:replace_with_postgres_password@postgres:5432/resqai
REDIS_URL=redis://localhost:6379

# --- Security & Authentication ---
SECRET_KEY=replace_with_a_random_secret
JWT_SECRET=replace_with_a_random_secret
# For the admin evidence proxy, Node's JWT_SECRET must equal FastAPI's SECRET_KEY.
# Use one random signing secret (at least 32 characters) in both variables.
ADMIN_PASSWORD=replace_with_an_admin_password

# --- Google Gemini AI ---
AI_API_KEY=your_gemini_api_key
AI_MODEL=gemini-3.5-flash-lite

# --- Administrator recovery email; citizen OTPs use SMSlenz ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_specific_password
SMTP_FROM_EMAIL=your_email@gmail.com

# --- Sri Lanka SMS Gateway (SMSlenz) ---
SMSLENZ_USER_ID=your_smslenz_user_id
SMSLENZ_API_KEY=your_smslenz_api_key
SMSLENZ_SENDER_ID=your_smslenz_sender_id
SMSLENZ_BASE_URL=https://smslenz.lk/api

# --- Google Maps Configuration ---
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# --- Mobile risk assessment service ---
# Use your hosted ML service HTTPS URL for an Expo APK build.
# Local Docker web development uses the exposed port below.
EXPO_PUBLIC_ML_API_URL=http://localhost:5005

# Same private random value (at least 32 characters) on FastAPI and Node only.
INTERNAL_API_KEY=

# Node -> Python for real administrator OTP resend
FASTAPI_URL=http://localhost:8000
# Python -> Node for private coordinator notifications
# On Render set this on the FastAPI service to the Node service's HTTPS URL,
# for example https://resqai-platform-backend.onrender.com (never localhost).
# Docker Compose supplies http://node-backend:5000 automatically.
NODE_BACKEND_URL=http://localhost:5000

# Private request evidence only: separate 32 random bytes encoded as base64url.
# Generate with: python -c 'import base64,secrets; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())'
EVIDENCE_ENCRYPTION_KEY=
