{
  "expo": {
    "name": "ResQAI",
    "slug": "resqai",
    "version": "1.0.0",
    "scheme": "resqai",
    "orientation": "portrait",
    "icon": "./assets/resqai_logo_square.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.resqai.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "ResQAI needs your location to find nearby hospitals and emergency services.",
        "NSSpeechRecognitionUsageDescription": "Allow $(PRODUCT_NAME) to use speech recognition.",
        "NSMicrophoneUsageDescription": "Allow $(PRODUCT_NAME) to use the microphone."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0A1628",
        "foregroundImage": "./assets/resqai_logo_square.png"
      },
      "package": "com.resqai.app",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-sqlite",
      "expo-router",
      "expo-location",
      "expo-speech-recognition",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0A1628",
          "image": "./assets/resqai_logo_square.png",
          "imageWidth": 180,
          "resizeMode": "contain"
        }
      ],
      "./plugins/withLauncherIconPadding",
      "expo-notifications"
    ],
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "8e43fa10-d6c5-4d2e-ac6d-f855ec38ab7c"
      }
    }
  }
}
