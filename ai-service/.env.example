GEMINI_API_KEY=your_gemini_api_key
LLM_MODEL=gemini-3.8-flash
# Try a different model immediately after a temporary failure, before retrying.
# Unset/blank uses gemini-3.5-flash-lite. Custom IDs must be enabled for your project.
LLM_FALLBACK_MODELS=gemini-3.5-flash-lite
# The SDK also sends this deadline to Gemini. Allow time for generation.
LLM_MODEL_TIMEOUT_SECONDS=30
# Allow both primary and backup a full attempt, plus backoff.
LLM_REQUEST_TIMEOUT_SECONDS=65
DATABASE_URL=postgresql://user:password@localhost:5433/resqai
PORT=8001
HOST=0.0.0.0
